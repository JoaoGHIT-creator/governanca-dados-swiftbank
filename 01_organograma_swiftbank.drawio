<mxfile host="app.diagrams.net"><diagram name="Página-1" id="pg1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1" value="CAMADA ESTRATÉGICA — decide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1660" height="200" as="geometry"/></mxCell><mxCell id="L2" value="CAMADA TÁTICA — traduz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F0DA;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1660" height="490" as="geometry"/></mxCell><mxCell id="L3" value="CAMADA OPERACIONAL — operacionaliza e usa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1660" height="260" as="geometry"/></mxCell><mxCell id="board" value="&lt;b&gt;Board patrocinador&lt;/b&gt;&lt;br&gt;Patrocina o programa, aprova a estratégia e garante recursos e prioridade executiva." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="340" height="130" as="geometry"/></mxCell><mxCell id="cdo" value="&lt;b&gt;CDO (Chief Data Officer)&lt;/b&gt;&lt;br&gt;Define a visão e as políticas de dados e responde pelo programa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="465" y="70" width="340" height="130" as="geometry"/></mxCell><mxCell id="dgo" value="&lt;b&gt;Comitê / DGO de Governança&lt;/b&gt;&lt;br&gt;Decide prioridades, aprova políticas e resolve conflitos entre áreas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="340" height="130" as="geometry"/></mxCell><mxCell id="dpo" value="&lt;b&gt;DPO (Encarregado LGPD)&lt;/b&gt;&lt;br&gt;Orienta sobre a LGPD, atende titulares e fala com a ANPD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1275" y="70" width="340" height="130" as="geometry"/></mxCell><mxCell id="do_com" value="&lt;b&gt;Data Owner — Comercial&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Comercial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_com" value="&lt;b&gt;Business Steward — Comercial&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Comercial no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="do_cre" value="&lt;b&gt;Data Owner — Crédito&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Crédito." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="325" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_cre" value="&lt;b&gt;Business Steward — Crédito&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Crédito no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="325" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="do_fin" value="&lt;b&gt;Data Owner — Financeiro&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Financeiro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="590" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_fin" value="&lt;b&gt;Business Steward — Financeiro&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Financeiro no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="590" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="do_mkt" value="&lt;b&gt;Data Owner — Marketing&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Marketing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="855" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_mkt" value="&lt;b&gt;Business Steward — Marketing&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Marketing no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="855" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="do_ope" value="&lt;b&gt;Data Owner — Operações&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Operações." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_ope" value="&lt;b&gt;Business Steward — Operações&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Operações no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="do_jur" value="&lt;b&gt;Data Owner — Jurídico/Compliance&lt;/b&gt;&lt;br&gt;Define regras de negócio e aprova acessos no domínio Jurídico e Compliance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1385" y="300" width="245" height="120" as="geometry"/></mxCell><mxCell id="bs_jur" value="&lt;b&gt;Business Steward — Jurídico/Compliance&lt;/b&gt;&lt;br&gt;Mantém definições, qualidade e metadados do domínio Jurídico e Compliance no dia a dia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1385" y="470" width="245" height="120" as="geometry"/></mxCell><mxCell id="ts" value="&lt;b&gt;Technical Steward (transversal)&lt;/b&gt;&lt;br&gt;Traduz regras de negócio em metadados técnicos, linhagem e regras de qualidade nas ferramentas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C3E6CB;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="1570" height="80" as="geometry"/></mxCell><mxCell id="cust" value="&lt;b&gt;Data Custodians / DBA&lt;/b&gt;&lt;br&gt;Operam bancos e armazenamento, executando backups, permissões e retenção aprovados pelos Owners." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="370" height="150" as="geometry"/></mxCell><mxCell id="eng" value="&lt;b&gt;Engenharia de Dados&lt;/b&gt;&lt;br&gt;Constrói e mantém pipelines bronze, silver e gold com testes de qualidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="830" width="370" height="150" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Segurança da Informação&lt;/b&gt;&lt;br&gt;Protege dados com controles de acesso, criptografia, monitoramento e resposta a incidentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="830" width="370" height="150" as="geometry"/></mxCell><mxCell id="champ" value="&lt;b&gt;Data Champions (papel natural)&lt;/b&gt;&lt;br&gt;Multiplicam boas práticas nas áreas e reportam problemas de dados aos Stewards." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="830" width="370" height="150" as="geometry"/></mxCell><mxCell id="e0" value="colabora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="do_com" target="bs_com"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="colabora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="do_cre" target="bs_cre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="colabora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="do_fin" target="bs_fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="colabora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="do_mkt" target="bs_mkt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="colabora" style="edgeStyle=orthogonalEdgeStyle;r