<mxfile host="app.diagrams.net"><diagram name="Página-1" id="pg1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hdr" value="CICLO DE VIDA DO DADO — conceito &amp;quot;Cliente Ativo&amp;quot; (SwiftBank)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1780" height="980" as="geometry"/></mxCell><mxCell id="h_coleta" value="&lt;b&gt;1. COLETA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="70" as="geometry"/></mxCell><mxCell id="a_coleta" value="&lt;b&gt;Atores&lt;/b&gt;&lt;br&gt;Marketing e Operações, Data Owner de Clientes, DPO, Jurídico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="120" as="geometry"/></mxCell><mxCell id="p_coleta" value="&lt;b&gt;Perguntas-chave&lt;/b&gt;&lt;br&gt;Temos base legal para coletar?&lt;br&gt;Qual a finalidade declarada?&lt;br&gt;O consentimento foi registrado?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="e_coleta" value="&lt;b&gt;Exemplo no SwiftBank (clientes_swiftbank.csv)&lt;/b&gt;&lt;br&gt;Campo consentimento_marketing entra como Sim/Não no cadastro (29 Sim e 16 Não entre 45 clientes)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="320" height="200" as="geometry"/></mxCell><mxCell id="r_coleta" value="&lt;b&gt;Risco LGPD&lt;/b&gt;&lt;br&gt;Coletar sem finalidade clara ou sem registrar o consentimento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#B85450;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="320" height="130" as="geometry"/></mxCell><mxCell id="h_armaz" value="&lt;b&gt;2. ARMAZENAMENTO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="320" height="70" as="geometry"/></mxCell><mxCell id="a_armaz" value="&lt;b&gt;Atores&lt;/b&gt;&lt;br&gt;Engenharia de Dados, Data Custodians/DBA, Segurança da Informação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="320" height="120" as="geometry"/></mxCell><mxCell id="p_armaz" value="&lt;b&gt;Perguntas-chave&lt;/b&gt;&lt;br&gt;Onde o dado fica (bz, sl, gd)?&lt;br&gt;Quem pode acessar cada camada?&lt;br&gt;O dado está protegido?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="e_armaz" value="&lt;b&gt;Exemplo no SwiftBank (clientes_swiftbank.csv)&lt;/b&gt;&lt;br&gt;bz_clientes guarda o dado bruto, sl_clientes harmoniza e gd_clientes_ativos publica flag_ativo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="520" width="320" height="200" as="geometry"/></mxCell><mxCell id="r_armaz" value="&lt;b&gt;Risco LGPD&lt;/b&gt;&lt;br&gt;Dado pessoal em camada aberta, sem controle de acesso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#B85450;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="750" width="320" height="130" as="geometry"/></mxCell><mxCell id="h_recup" value="&lt;b&gt;3. RECUPERAÇÃO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="320" height="70" as="geometry"/></mxCell><mxCell id="a_recup" value="&lt;b&gt;Atores&lt;/b&gt;&lt;br&gt;Data Owner (aprova), Business Steward, Custodians (extraem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="320" height="120" as="geometry"/></mxCell><mxCell id="p_recup" value="&lt;b&gt;Perguntas-chave&lt;/b&gt;&lt;br&gt;Quem pede e quem aprova o acesso?&lt;br&gt;Precisa de todas as colunas?&lt;br&gt;O pedido fica registrado?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="e_recup" value="&lt;b&gt;Exemplo no SwiftBank (clientes_swiftbank.csv)&lt;/b&gt;&lt;br&gt;Marketing pede lista de clientes: o Owner aprova só id_cliente e segmento, sem nome e cidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="520" width="320" height="200" as="geometry"/></mxCell><mxCell id="r_recup" value="&lt;b&gt;Risco LGPD&lt;/b&gt;&lt;br&gt;Extração ampla, com identificação direta, sem aprovação do Owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#B85450;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="750" width="320" height="130" as="geometry"/></mxCell><mxCell id="h_uso" value="&lt;b&gt;4. USO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="70" width="320" height="70" as="geometry"/></mxCell><mxCell id="a_uso" value="&lt;b&gt;Atores&lt;/b&gt;&lt;br&gt;Marketing, Crédito, Financeiro, Data Champions, Business Stewards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="320" height="120" as="geometry"/></mxCell><mxCell id="p_uso" value="&lt;b&gt;Perguntas-chave&lt;/b&gt;&lt;br&gt;O uso respeita a finalidade?&lt;br&gt;A regra de Cliente Ativo é a oficial?&lt;br&gt;Há consentimento para este uso?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="e_uso" value="&lt;b&gt;Exemplo no SwiftBank (clientes_swiftbank.csv)&lt;/b&gt;&lt;br&gt;Campanha só para status_conta = Ativa e consentimento_marketing = Sim (29 de 45 clientes)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="520" width="320" height="200" as="geometry"/></mxCell><mxCell id="r_uso" value="&lt;b&gt;Risco LGPD&lt;/b&gt;&lt;br&gt;Campanha para quem disse Não; decisão de crédito com regra divergente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#B85450;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1090" y="750" width="320" height="130" as="geometry"/></mxCell><mxCell id="h_desc" value="&lt;b&gt;5. DESCARTE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="70" width="320" height="70" as="geometry"/></mxCell><mxCell id="a_desc" value="&lt;b&gt;Atores&lt;/b&gt;&lt;br&gt;Data Owner, Jurídico/Compliance, DPO, Custodians, Segurança" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="170" width="320" height="120" as="geometry"/></mxCell><mxCell id="p_desc" value="&lt;b&gt;Perguntas-chave&lt;/b&gt;&lt;br&gt;Quando a finalidade acabou?&lt;br&gt;Há prazo legal de guarda?&lt;br&gt;Como comprovar a eliminação?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="e_desc" value="&lt;b&gt;Exemplo no SwiftBank (clientes_swiftbank.csv)&lt;/b&gt;&lt;br&gt;9 contas Inativa ou Encerrada (CLI003, CLI008...) entram na rotina de retenção e eliminação ou anonimização." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="520" width="320" height="200" as="geometry"/></mxCell><mxCell id="r_desc" value="&lt;b&gt;Risco LGPD&lt;/b&gt;&lt;br&gt;Manter dado pessoal de conta encerrada além do prazo e da finalidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#B85450;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="750" width="320" height="130" as="geometry"/></mxCell><mxCell id="nota" value="Definição padrão de Cliente Ativo: status_conta = Ativa e ao menos uma transação efetivada nos últimos 90 dias. Uso em campanhas exige também consentimento_marketing = Sim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="1720" height="65" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="h_coleta" target="h_armaz"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="h_armaz" target="h_recup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="h_recup" target="h_uso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="h_uso" target="h_desc"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>